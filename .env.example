# ========== Meta Pixel (frontend - navegador) ==========
# Obtenha o ID em: Gerenciador de Eventos do Meta > Configurações do Pixel
VITE_META_PIXEL_ID=

# ========== Conversions API (CAPI) - endpoint do seu backend ==========
# URL do endpoint que envia eventos com o token (ex: deploy na Vercel = https://seu-projeto.vercel.app/api/conversion)
# Se definido, cada conversão será enviada também pela CAPI (servidor), com deduplicação pelo mesmo event_id
VITE_CAPI_ENDPOINT=

# ========== Variáveis do SERVIDOR (NUNCA no frontend) ==========
# Use apenas no painel da Vercel (ou .env do servidor) - NÃO coloque em .env commitado
# META_PIXEL_ID=123456789
# META_CAPI_ACCESS_TOKEN=seu_token_de_acesso_aqui
